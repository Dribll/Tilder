# Tilder server environment

# Local Node server port
PORT=3210

# Public backend URL used to build OAuth callback URLs and sync endpoints.
# Web local dev:
# PUBLIC_BASE_URL=http://localhost:3210
# Hosted production:
# PUBLIC_BASE_URL=https://your-api-domain.example.com
PUBLIC_BASE_URL=http://localhost:3210

# Public frontend URL that users actually open in the browser.
# Local web app:
# FRONTEND_BASE_URL=http://localhost:5173
# Hosted web app:
# FRONTEND_BASE_URL=https://your-web-domain.example.com
FRONTEND_BASE_URL=http://localhost:5173

# Optional explicit CORS allow-list.
# Leave blank for local development unless you need cross-origin auth.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides
# GIT_BINARY=git
# TILDER_RUNNER_URL=https://ce.judge0.com
# TILDER_TERMINAL_CWD=D:\Tilder\web-app
# TILDER_TERMINAL_SHELL=powershell.exe

# Settings sync storage in the connected GitHub account
TILDER_GITHUB_SYNC_REPO=tilder-settings-sync
TILDER_GITHUB_SYNC_FILE=settings-sync.json

# Session encryption secret used by both web and desktop auth/sync flows.
# Replace this with your own long random string before deployment.
TILDER_SESSION_SECRET=replace-with-a-long-random-secret

# GitHub OAuth
# Recommended: use one GitHub OAuth app for local dev and another for production,
# because GitHub OAuth apps allow only one callback URL per app.
# Local callback example:  http://localhost:3210/api/auth/github/callback
# Hosted callback example: https://your-api-domain.example.com/api/auth/github/callback
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret

# Microsoft OAuth
# Microsoft app registrations can carry multiple redirect URIs.
# Local callback example:  http://localhost:3210/api/auth/microsoft/callback
# Hosted callback example: https://your-api-domain.example.com/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=replace-with-your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# Tilder production environment for https://tilder-web-app.onrender.com

# Render provides PORT automatically. Keep this only if you need a default locally.
PORT=10000

PUBLIC_BASE_URL=https://tilder-web-app.onrender.com
FRONTEND_BASE_URL=https://tilder-web-app.onrender.com
CORS_ALLOWED_ORIGINS=https://tilder-web-app.onrender.com

# Optional overrides
# GIT_BINARY=git
# TILDER_RUNNER_URL=https://ce.judge0.com
# TILDER_TERMINAL_SHELL=powershell.exe

TILDER_GITHUB_SYNC_REPO=tilder-settings-sync
TILDER_GITHUB_SYNC_FILE=settings-sync.json
TILDER_SESSION_SECRET=replace-with-a-long-random-secret

# GitHub OAuth app for production
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret

# Microsoft app registration for production
MICROSOFT_CLIENT_ID=replace-with-your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

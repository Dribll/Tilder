# Shared Tilder auth + settings-sync environment
# Use this for both the desktop bundled backend and the web backend so settings
# sync to the same GitHub account and stay consistent between desktop and web.

PORT=3210

# Public backend URL used for OAuth callbacks and sync endpoints.
# Local shared backend:
PUBLIC_BASE_URL=http://localhost:3210

# Public frontend URL opened by the user in the browser for the web app.
FRONTEND_BASE_URL=http://localhost:5173

# Explicitly allow the local web app and Tauri desktop shell.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost

# Real Windows shell for the integrated terminal.
TILDER_TERMINAL_SHELL=powershell.exe

# GitHub settings-sync repository/file used after the user connects GitHub.
TILDER_GITHUB_SYNC_REPO=tilder-settings-sync
TILDER_GITHUB_SYNC_FILE=settings-sync.json

# Strong shared session secret for desktop/web auth + sync cookies.
TILDER_SESSION_SECRET=replace-with-a-long-random-secret

# GitHub OAuth app
# Callback URL:
# http://localhost:3210/api/auth/github/callback
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret

# Microsoft OAuth app
# Callback URL:
# http://localhost:3210/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=replace-with-your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

{
  "name": "tilder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "desktop:dev": "npm run build:desktop -- --dev && tauri dev",
    "desktop:build": "npm run build:desktop && npm run tauri:build",
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node server.js",
    "start": "node server.js",
    "terminal-bridge": "node terminal-bridge.js",
    "tilderx": "node scripts/tilderx.mjs",
    "build:monitor": "cd TilderMonitorService && dotnet publish -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o ../src-tauri/windows/monitor_bin",
    "build:desktop": "npm run build:monitor && npm run build && node scripts/prepare-tauri-runtime.mjs",
    "sync:snippets": "node scripts/sync-friendly-snippets.mjs",
    "sync:completions": "node scripts/sync-monaco-completions.mjs",
    "build": "vite build",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm run build:desktop -- --dev && tauri dev",
    "tauri:build": "tauri build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@astrojs/language-server": "^2.16.6",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^6.4.2",
    "@fortawesome/free-regular-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@microsoft/compose-language-service": "^0.5.0",
    "@monaco-editor/react": "^4.5.1",
    "@prisma/language-server": "^31.10.0",
    "@taplo/cli": "^0.7.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tinymce/tinymce-react": "^6.3.0",
    "@vscjava/java-language-server": "^0.1.2",
    "@vscjava/java-ls-config-win32": "^0.1.2",
    "@vue/language-server": "^3.2.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bash-language-server": "^5.6.0",
    "bootstrap": "^5.3.2",
    "dockerfile-language-server-nodejs": "^0.15.0",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "emmet-monaco-es": "^5.7.0",
    "express": "^5.2.1",
    "graphql-language-service-cli": "^3.5.0",
    "handsontable": "^17.1.0",
    "intelephense": "^1.18.0",
    "mammoth": "^1.12.0",
    "moment": "^2.30.1",
    "monaco-themes": "^0.4.4",
    "ngrok": "^5.0.0-beta.2",
    "node-pty": "^1.1.0",
    "node-windows": "^1.0.0-beta.8",
    "pyright": "^1.1.409",
    "react": "^18.3.1",
    "react-bootstrap": "^2.8.0",
    "react-dom": "^18.2.0",
    "react-file-icon": "^1.6.0",
    "react-icons": "^5.6.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.0",
    "simple-git": "^3.33.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql-language-server": "^1.7.1",
    "svelte-language-server": "^0.17.30",
    "systeminformation": "^5.31.7",
    "tinymce": "^8.6.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.1.3",
    "xlsx": "^0.18.5",
    "yaml-language-server": "^1.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "gh-pages": "^6.1.1",
    "vite": "^4.5.9"
  }
}
